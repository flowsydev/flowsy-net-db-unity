<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>

        <OutputType>Exe</OutputType>
        <UseAppHost>true</UseAppHost>
        <TestTfmsInParallel>false</TestTfmsInParallel>
        <IsPackable>false</IsPackable>
        <IsTestProject>true</IsTestProject>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="coverlet.collector" Version="10.0.1">
          <PrivateAssets>all</PrivateAssets>
          <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Evolve" Version="3.2.0" />
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.6.0" />
        <PackageReference Include="MySqlConnector" Version="2.6.0" />
        <PackageReference Include="Serilog" Version="4.3.1" />
        <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
        <PackageReference Include="SSH.NET" Version="2026.0.0" />
        <PackageReference Include="Shouldly" Version="4.3.0" />
        <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="3.53.3" />
        <PackageReference Include="Testcontainers.MySql" Version="4.12.0" />
        <PackageReference Include="Testcontainers.PostgreSql" Version="4.12.0" />
        <PackageReference Include="xunit.v3" Version="3.2.2" />
        <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
    </ItemGroup>

    <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
        <PackageReference Include="Microsoft.Extensions.Configuration" Version="8.0.0" />
        <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="8.0.1" />
        <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.1" />
        <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.27" />
        <PackageReference Include="Npgsql" Version="8.0.9" />
        <PackageReference Include="Serilog.Extensions.Hosting" Version="8.0.0" />
    </ItemGroup>

    <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
        <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.8" />
        <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.8" />
        <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.8" />
        <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.8" />
        <PackageReference Include="Npgsql" Version="10.0.3" />
        <PackageReference Include="Serilog.Extensions.Hosting" Version="10.0.0" />
    </ItemGroup>
    
    <ItemGroup>
        <Content Include="appsettings.json" CopyToOutputDirectory="Always" />
        <None Include="Mock/Infrastructure/Database/Scripts/**/*.*" CopyToOutputDirectory="Always" />
    </ItemGroup>

    <ItemGroup>
        <Using Include="Xunit"/>
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\Flowsy.Db.Unity\Flowsy.Db.Unity.csproj" />
      <ProjectReference Include="..\Flowsy.Db.Unity.Postgres\Flowsy.Db.Unity.Postgres.csproj" />
    </ItemGroup>

    <ItemGroup>
      <Folder Include="Mock\Infrastructure\Database\Scripts\MySql\Migrations\Versioned\" />
      <Folder Include="Mock\Infrastructure\Database\Scripts\MySql\Operations\" />
      <Folder Include="Scenarios\MySql\" />
    </ItemGroup>

</Project>
